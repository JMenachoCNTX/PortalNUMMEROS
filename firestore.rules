rules_version = '2';
// Reglas de seguridad del Portal CONTAX.
// - Cada repartidor solo puede leer SUS datos.
// - El administrador (cuenta con el permiso "admin") puede leer todo y editar
//   anuncios, avisos y preguntas (publico/contenido) y subir imágenes.
// - Los datos de pagos los escribe solo la sincronización (servidor).
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() { return request.auth != null; }
    function esAdmin() { return conSesion() && request.auth.token.admin == true; }

    match /repartidores/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow write: if false;

      match /lecturas/{codigo} {
        allow read: if conSesion() && (request.auth.uid == uid || esAdmin());
        allow create, update: if conSesion() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['fecha', 'titulo', 'codigo', 'id', 'nombre'])
          && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 200
          && (!('nombre' in request.resource.data) || request.resource.data.nombre.size() <= 120);
      }
    }

    // Para que el administrador cuente quién leyó cada aviso
    match /{ruta=**}/lecturas/{codigo} {
      allow read: if esAdmin();
    }

    match /publico/{doc} {
      allow read: if conSesion();
      allow write: if esAdmin() && doc == 'contenido';
    }

    // Imágenes subidas desde el panel (la sincronización las pasa a GitHub)
    match /imagenes/{id} {
      allow read, delete: if esAdmin();
      allow create, update: if esAdmin() && request.resource.data.datos is string
        && request.resource.data.datos.size() < 950000;
    }

    // Conversaciones con el asistente: cada repartidor registra las suyas
    match /chats/{id} {
      allow create: if conSesion() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'id', 'nombre', 'pregunta', 'respuesta', 'tokens', 'fecha'])
        && request.resource.data.pregunta is string && request.resource.data.pregunta.size() <= 600
        && request.resource.data.respuesta is string && request.resource.data.respuesta.size() <= 3000;
      allow read: if esAdmin();
    }

    // Celular donde cada repartidor recibe notificaciones (un dispositivo por persona)
    match /notificaciones/{uid} {
      allow read: if conSesion() && (request.auth.uid == uid || esAdmin());
      allow create, update: if conSesion() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['tokens', 'plataforma', 'actualizado'])
        && request.resource.data.tokens is list && request.resource.data.tokens.size() <= 3;
      allow delete: if conSesion() && request.auth.uid == uid;
    }

    // Notificaciones que manda el administrador (el robot las envía)
    match /colaNotif/{id} {
      allow read, create: if esAdmin();
    }

    // Lo que venía de las hojas viejas (ChatLog, AvisosLeidos)
    match /archivo/{doc} {
      allow read: if esAdmin();
    }

    // Todo lo demás (por ejemplo privado/estado) queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
